<?xml version="1.0" encoding="utf-8"?>
<!--
    Which directories the FileProvider is allowed to hand out content:// URIs for.

    Deliberately narrow: two named subdirectories of the app's internal cache, and nothing else.
    The encrypted originals under files/ and the key files under files/keys/ are never exposed
    here — the provider simply cannot address them, so even a buggy caller can't leak a ciphertext
    file or, far worse, a key.

    attachment-preview  AttachmentAccess writes the *decrypted* temporary copy of an attachment
                        here right before opening or sharing it.

    camera-capture      Where the system camera app writes a photo taken from the assistant's
                        attach menu (B-group task 16). Scratch by design: the image is read into
                        the pending attachment as soon as the shutter closes, so the file is dead
                        weight from that moment and the OS may reclaim it whenever it likes. It is
                        a separate entry rather than a widened path on the one above, so each
                        directory stays addressable for exactly one purpose.
-->
<paths>
    <cache-path name="attachment-preview" path="attachment-preview/" />
    <cache-path name="camera-capture" path="camera-capture/" />
</paths>
